{
  "adapters": [
    {
      "name": "reference-typescript",
      "command": ["node", "conformance/adapters/reference/adapter.ts"],
      "cwd": "."
    },
    {
      "name": "typescript",
      "command": ["node", "conformance/adapters/typescript/adapter.ts"],
      "cwd": "."
    },
    {
      "name": "python",
      "command": ["packages/python/.venv/bin/python", "conformance/adapters/python/adapter.py"],
      "cwd": "."
    },
    {
      "name": "dotnet",
      "command": ["dotnet", "packages/dotnet/adapter/out/Cruma.Tron.Runner.ConformanceAdapter.dll"],
      "cwd": "."
    },
    {
      "name": "rust",
      "command": ["cargo", "run", "--quiet", "--manifest-path", "packages/rust/Cargo.toml", "-p", "cruma-tron-runner-conformance-adapter"],
      "cwd": "."
    }
  ]
}
